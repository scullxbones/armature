["create","bug-1780487596",1780487596,"codex-worker",{"title":"RepoRunner blocks on stale claims instead of taking over","parent":"ORCRUN","type":"bug","scope":["internal/orchestrate/run.go","internal/orchestrate/run_test.go"],"acceptance":["TestPrepare_StaleClaim_AllowsTakeover passes","make check green"],"definition_of_done":"prepare() calls claimPkg.IsClaimStale before returning a blocked result for another worker's claim. A stale claim allows takeover rather than blocking forever. Tests cover the stale-claim takeover path.","priority":"high"}]
["create","bug-1780487602",1780487602,"codex-worker",{"title":"RepoRunner scope check includes stale claims and ancestor tasks","parent":"ORCRUN","type":"bug","scope":["internal/orchestrate/run.go","internal/orchestrate/run_test.go"],"acceptance":["TestPrepare_ScopeConflict_SkipsStaleClaim passes","TestPrepare_ScopeConflict_SkipsAncestor passes","make check green"],"definition_of_done":"activeScopes loop in prepare() skips stale claims (via claimPkg.IsClaimStale) and ancestor issues (via isAncestorIssue), matching the filtering that runtimeActiveScopes previously provided. Tests cover both skip paths.","priority":"medium"}]
["create","bug-1780487607",1780487607,"codex-worker",{"title":"arm orchestrate JSON output omits blocked_reason and would_dispatch","parent":"ORCRUN","type":"bug","scope":["cmd/armature/orchestrate.go"],"acceptance":["arm orchestrate --dry-run --format json shows would_dispatch=false and blocked_reason when task is claimed","make check green"],"definition_of_done":"JSON payload includes blocked_reason, would_dispatch, scope_conflicts, would_claim, and claim_owner fields from RunResult whenever they carry meaningful values. Callers using --format json can distinguish blocked from pending.","priority":"medium"}]
["create","bug-1780487613",1780487613,"codex-worker",{"title":"Worker runtime counts blocked lifecycle outcomes as completed tasks","parent":"ORCRUN","type":"bug","scope":["cmd/armature/worker_run.go"],"acceptance":["TestRepoOrchestrator_BlockedLifecycle_ReturnsError passes","make check green"],"definition_of_done":"repoOrchestrator.Run returns an error when result.LifecycleOutcome.Status == StatusBlocked, so the worker runtime does not increment TasksCompleted for tasks that complete with a blocked lifecycle outcome (e.g. zero-trust commit blocked).","priority":"medium"}]
["create","bug-1780487618",1780487618,"codex-worker",{"title":"RepoRunner claim op not pushed in dual-branch mode","parent":"ORCRUN","type":"bug","scope":["internal/orchestrate/run.go","internal/orchestrate/run_test.go"],"acceptance":["TestPrepare_DualBranch_ClaimPushed passes","make check green"],"definition_of_done":"In dual-branch mode, RepoRunner pushes the claim op to _armature after AppendAndCommit, matching appendHighStakesOp semantics. Other workers can observe the claim without waiting for an independent push.","priority":"medium"}]
["create","bug-1780487624",1780487624,"codex-worker",{"title":"RepoRunner probes auth before dry-run guard","parent":"ORCRUN","type":"bug","scope":["internal/orchestrate/run.go","internal/orchestrate/run_test.go"],"acceptance":["TestPrepare_DryRun_SkipsAuth passes","make check green"],"definition_of_done":"resolveAuthPlan is called only after the dry-run early return in prepare(), so dry runs never fail on missing credentials. Already addressed by local commit 8819e91; this bug tracks pushing that fix to the PR.","priority":"medium"}]
["create","bug-1780487630",1780487630,"codex-worker",{"title":"scopesOverlap in RepoRunner uses prefix matching instead of globs","parent":"ORCRUN","type":"bug","scope":["internal/orchestrate/run.go","internal/orchestrate/run_test.go"],"acceptance":["TestScopesOverlap_GlobPattern passes","dry-run WouldDispatch matches real-run scope check for glob scopes","make check green"],"definition_of_done":"scopesOverlap replaced with claimPkg.ScopesOverlap so that glob patterns like src/*.go correctly match concrete paths like src/foo.go. Dry-run WouldDispatch result is consistent with the engine's glob-aware scope check.","priority":"medium"}]
