["create","ORCRUN-T04",1780450256,"codex-worker",{"title":"Record explicit lifecycle outcomes for complete runs","parent":"ORCRUN-S1","type":"task","scope":["internal/orchestrate/engine.go","internal/orchestrate/run.go (new)","internal/orchestrate/engine_test.go","internal/orchestrate/core_service_test.go","cmd/armature/orchestrate_test.go"],"acceptance":["complete run result includes LifecycleOutcome","no-commit run records a blocked or otherwise explicit lifecycle outcome","phase complete without lifecycle outcome is covered by a failing regression test","go test ./internal/orchestrate ./cmd/armature passes","make check green"],"definition_of_done":"A complete orchestration phase always reports and records an explicit task lifecycle outcome. No committed changes default to a blocked lifecycle outcome unless verification proves the task was already satisfied.","priority":"high","confidence":"draft"}]
