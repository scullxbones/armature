["create","ARCHIMP-S12-T3",1782174933,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Update arm merged --issue to tear down task/bug worktrees and warn on pass-throughs","parent":"ARCHIMP-S12","type":"task","scope":["cmd/armature/merged.go","cmd/armature/merged_test.go (new)"],"acceptance":["TestMergedRemovesTaskWorktree_REQ_ARCHIMP-S12-T3 passes","TestMergedRemovesBugWorktree_REQ_ARCHIMP-S12-T3 passes","TestMergedDoesNotRemoveStoryWorktree_REQ_ARCHIMP-S12-T3 passes","TestMergedWarnsOnPassThroughLog_REQ_ARCHIMP-S12-T3 passes","TestMergedNoWarnWhenLogAbsent_REQ_ARCHIMP-S12-T3 passes","make check green"],"definition_of_done":"arm merged --issue removes git worktree for task-type and bug-type issues via git worktree remove. Reads \u003cgit-dir\u003e/armature-hook.log from that worktree before removal; emits warning to stderr if any pass-through entries present. Story/feature issues: no worktree removal.","priority":"high","confidence":"draft"}]
