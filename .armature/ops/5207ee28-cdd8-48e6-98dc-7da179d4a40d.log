["create","ARCHIMP-S12-T1",1782174933,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Add --worktree to arm claim: create/update worktree and write task binding file","parent":"ARCHIMP-S12","type":"task","scope":["cmd/armature/claim.go","cmd/armature/claim_test.go (new)"],"acceptance":["TestClaimRequiresWorktree_REQ_ARCHIMP-S12-T1 passes","TestClaimCreatesWorktreeOnStoryBranch_REQ_ARCHIMP-S12-T1 passes","TestClaimCreatesWorktreeOnTaskBranch_REQ_ARCHIMP-S12-T1 passes","TestClaimCreatesWorktreeOnBugBranch_REQ_ARCHIMP-S12-T1 passes","TestClaimEpicReturnsError_REQ_ARCHIMP-S12-T1 passes","TestClaimWritesTaskBindingFile_REQ_ARCHIMP-S12-T1 passes","TestClaimUpdatesTaskBindingInExistingWorktree_REQ_ARCHIMP-S12-T1 passes","make check green"],"definition_of_done":"arm claim requires --worktree (error if omitted). Creates worktree + derived branch (feat/\u003cid\u003e, task/\u003cid\u003e, fix/\u003cid\u003e) if path absent; updates \u003cgit-dir\u003e/armature-task-id if path exists. Epic returns error. Branch off parent story branch for task/bug. Claim op still appended to ops log.","priority":"high","confidence":"draft"}]
["create","ARCHIMP-S12-T2",1782174933,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Update harness-hook to read binding from file, pass through silently, and log pass-throughs","parent":"ARCHIMP-S12","type":"task","scope":["cmd/armature/harness_hook.go","cmd/armature/harness_hook_test.go","internal/harnesshook/runner.go","internal/harnesshook/runner_test.go"],"acceptance":["TestHarnessHookPassesThroughWithoutTaskID_REQ_ARCHIMP-S12-T2 passes","TestHarnessHookPassesThroughWhenTaskDone_REQ_ARCHIMP-S12-T2 passes","TestHarnessHookPassesThroughWhenTaskMerged_REQ_ARCHIMP-S12-T2 passes","TestHarnessHookEnforcesWhenTaskClaimed_REQ_ARCHIMP-S12-T2 passes","TestHarnessHookEnforcesFromEnvVar_REQ_ARCHIMP-S12-T2 passes","TestHarnessHookLogsPassThroughToFile_REQ_ARCHIMP-S12-T2 passes","make check green"],"definition_of_done":"resolveTaskBinding(gitDir) reads \u003cgit-dir\u003e/armature-task-id, falls back to ARMATURE_TASK_ID, returns empty string when absent. Hook passes through (exit 0) when no binding or stale (status != claimed/in-progress). Pass-throughs logged to \u003cgit-dir\u003e/armature-hook.log. TestHarnessHookRequiresTaskID inverted to TestHarnessHookPassesThroughWithoutTaskID.","priority":"high","confidence":"draft"}]
