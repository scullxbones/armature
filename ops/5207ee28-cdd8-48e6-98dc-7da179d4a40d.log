["create","TOPTIER-S17",1783521987,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Scope-overlap validation gaps: transitive closure, parent/child containment, cross-story, phantom-scope","parent":"TOPTIER","type":"story","scope":["internal/claim/overlap.go","internal/validate/validate.go","internal/skillsembed/skills/armature-planner/references/dependency-management.md"],"acceptance":["All four sub-task acceptance criteria pass","arm validate and arm doctor exit 0 on a fixture repo reproducing each of the four original findings","make check green"],"definition_of_done":"The plan-time scope-overlap checker (arm validate, arm claim) closes all four defects documented in the scope-overlap-validation-gaps dogfood theme: transitive closure over blocked_by, parent/child scope-containment exclusion, cross-story overlap awareness, and phantom-scope blocker-file cross-referencing. armature-planner skill guidance reflects the fixed behavior. make check green.","priority":"high","confidence":"draft"}]
["create","TOPTIER-S17-T1",1783521987,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Fix parent/child scope-containment blind spot in ScopesOverlap","parent":"TOPTIER-S17","type":"task","scope":["internal/claim/overlap.go","internal/claim/overlap_test.go","cmd/armature/claim_test.go"],"acceptance":["TestScopesOverlap_ExcludesAncestorDescendantPairs_REQ_TOPTIER_S17_T1 passes","TestClaimCommand_NoFalsePositiveAgainstParentStory_REQ_TOPTIER_S17_T1 passes","make check green"],"definition_of_done":"ScopesOverlap (internal/claim/overlap.go), consumed by arm claim's claim-time check, excludes ancestor/descendant issue pairs from conflict comparison using dag.Graph's existing descendant queries, since a story's scope is by design the union of its children's scope. Reproduces and closes the 2026-06-30 DF-S5 false-positive finding (every child-task claim flagged scope overlap against its own parent story).","priority":"high","confidence":"draft"}]
["create","TOPTIER-S17-T2",1783521987,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Transitive closure over blocked_by in scope-overlap checks","parent":"TOPTIER-S17","type":"task","scope":["internal/validate/validate.go"],"acceptance":["TestCheckW1ScopeOverlap_SuppressesTransitivelyOrderedPairs_REQ_TOPTIER_S17_T2 passes","make check green"],"definition_of_done":"checkW1ScopeOverlap (internal/validate/validate.go) computes the full transitive closure of blocked_by before flagging overlap, so task pairs ordered via a multi-hop chain (not just a direct edge) no longer produce redundant WARNINGs. Direct-edge suppression behavior unchanged.","priority":"medium","confidence":"draft"}]
["create","TOPTIER-S17-T3",1783521987,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Cross-story scope-overlap awareness","parent":"TOPTIER-S17","type":"task","scope":["internal/validate/validate.go"],"acceptance":["TestCheckW1ScopeOverlap_FlagsCrossStoryOverlap_REQ_TOPTIER_S17_T3 passes","make check green"],"definition_of_done":"Scope-overlap checking scans across story boundaries, not just within one story's task set, so two tasks in different stories sharing a scoped file with no ordering edge between them produce a WARNING. This closes the theme's documented 'most dangerous, currently silent' case.","priority":"medium","confidence":"draft"}]
["create","TOPTIER-S17-T4",1783521987,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Phantom-scope cross-reference against blocker's (new) files","parent":"TOPTIER-S17","type":"task","scope":["internal/validate/validate.go"],"acceptance":["TestCheckW10PhantomScope_SuppressesForBlockerCreatedFiles_REQ_TOPTIER_S17_T4 passes","make check green"],"definition_of_done":"checkW10PhantomScope (internal/validate/validate.go) cross-references a blocking task's (new)-annotated files against a downstream task's scope declarations before emitting the phantom-scope INFO, so a legitimately-blocked file created by an upstream task no longer triggers a spurious warning.","priority":"medium","confidence":"draft"}]
["create","TOPTIER-S17-T5",1783521987,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Update armature-planner skill guidance for fixed scope-overlap semantics","parent":"TOPTIER-S17","type":"task","scope":["internal/skillsembed/skills/armature-planner/references/dependency-management.md"],"acceptance":["make validate-skills passes","grep -L confirms no stale guidance describing the old direct-edge-only / same-story-only behavior remains in the file","make check green"],"definition_of_done":"internal/skillsembed/skills/armature-planner/references/dependency-management.md accurately describes the fixed scope-overlap checker (transitive closure, parent/child exclusion, cross-story scanning, blocker-file-aware phantom-scope) so coordinators/planners stop reaching for --force reflexively, per the DF-S5 and ARCHIMP-S18 findings.","priority":"medium","confidence":"draft"}]
