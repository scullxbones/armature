["create","NXTTN-S5-T2",1783480525,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Consolidate TTY detection into the single main.go mechanism","parent":"NXTTN-S5","type":"task","scope":["cmd/armature/dagsum.go","cmd/armature/stalereview.go"],"acceptance":["grep -rn 'IsTerminal' cmd/armature/*.go returns only the one call site in main.go","make check green"],"definition_of_done":"dagsum.go and stalereview.go no longer call tui.IsTerminal() directly; both read the --non-interactive flag (already auto-set by main.go's global TTY/format/env detection) instead of hand-rolling their own check.","priority":"medium","confidence":"draft"}]
["create","NXTTN-S5-T3",1783480525,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Execute the rename map: apply command/subcommand renames, no aliases","parent":"NXTTN-S5","type":"task","scope":["cmd/armature/*.go","docs/commands.md"],"acceptance":["make check green","arm --help shows only the new command names","docs/commands.md has zero references to a pre-rename command name"],"definition_of_done":"Every rename in NXTTN-S5-T1's rename map is applied directly to the Cobra command tree with no Aliases field and no deprecation warning; docs/commands.md reflects only the new names; old names are simply gone (breaking change, matching ADR 0010's and ADR 0011's no-shim reasoning).","priority":"medium","confidence":"draft"}]
