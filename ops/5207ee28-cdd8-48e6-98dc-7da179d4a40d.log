["create","LNGHZN-S5-T8",1786285110,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Enforce unrecognized managed worktrees in doctor","parent":"LNGHZN-S5","type":"task","scope":["internal/doctor/doctor.go,internal/doctor/doctor_test.go,docs/commands.md"],"acceptance":["arm doctor reports a worktree under the managed root with no issue binding as a problem","arm doctor --strict exits non-zero for that condition","arm worktree list still exits 0 when Unrecognized is non-empty","make check green"],"definition_of_done":"An unrecognized worktree under the managed root is enforced, not merely printed. A worktree at a managed path carrying no issue binding is reported by arm doctor as a health problem and fails doctor --strict, so an agent cannot proceed past it. arm worktree list keeps exit code 0: it is an inventory command agents call routinely and must not fail on the anomaly it exists to report.","context_files":["CONTEXT.md"],"priority":"medium","confidence":"draft"}]
