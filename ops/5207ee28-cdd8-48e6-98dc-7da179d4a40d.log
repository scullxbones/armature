["create","TOPTIER-S1-T3",1783426756,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Replace commit-discovery grep pseudocode with arm review commits","parent":"TOPTIER-S1","type":"task","scope":["internal/review/commits.go (new)","internal/review/commits_test.go (new)","cmd/armature/review.go","skills/armature-coordinator/SKILL.md","docs/commands.md"],"acceptance":["TestReviewCommits_REQ_TOPTIER-S1-T3 passes covering feat/fix/refactor/test/docs prefixes","coordinator skill contains no --grep commit-discovery pseudocode","docs/commands.md documents arm review commits"],"definition_of_done":"arm review commits \u003cissue-id\u003e lists the delivery commits for an issue across all conventional-commit type prefixes (feat/fix/refactor/test/docs/chore), replacing the coordinator skill's feat-only grep pseudocode which silently dropped other types. Skill and commands doc updated to use it.","context_files":["docs/design/top-tier-gap-analysis.md"],"priority":"medium","confidence":"draft"}]
["create","TOPTIER-S2",1783426756,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Schema contracts and envelope documentation","parent":"TOPTIER","type":"story","definition_of_done":"Every JSON artifact (plan, review bundle, conformance assessment, activity index) has a published in-repo JSON Schema validated against doc examples in CI, skill examples are generated from the CLI so they cannot drift, and a conventions page documents _REQ_ naming and commit format. Closes gap D2.","priority":"high","confidence":"draft"}]
