["create","ARCHIMP-S19",1784509899,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Deepen the TOPTIER-S3 recovery/replay hot spot: strict-decode docs, AppendLog, replay test home","parent":"ARCHIMP","type":"story","acceptance":["All three child tasks done","arm validate passes with no errors","make check green"],"definition_of_done":"Three small, related architecture fixes discovered via /improve-codebase-architecture + grilling are delivered: the stale strict-decode test comment is corrected, AppendRawLines is replaced by an owned AppendLog type with production/test-simulation separated, and replay_test.go is relocated to internal/materialize with the correct package clause.","priority":"medium","confidence":"draft"}]
["create","ARCHIMP-S19-T1",1784509899,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Correct stale DisallowUnknownFields comment in strictdecode_test.go","parent":"ARCHIMP-S19","type":"task","scope":["internal/decompose/strictdecode_test.go"],"acceptance":["TestPlanAllowsUnknownFields_REQ_ARCHIMP_S19_T1 passes (or existing equivalently named test still passes with corrected surrounding comment)","Comment no longer references DisallowUnknownFields","make check green"],"definition_of_done":"The header comment (lines 5-8) in strictdecode_test.go accurately describes actual decode behavior: trailing JSON is rejected, unknown fields are accepted. No behavior change — this is a documentation-only fix confirmed against the deliberate PR #81 policy in internal/strictjson/decode.go.","priority":"low","confidence":"draft"}]
["create","ARCHIMP-S19-T2",1784509899,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Replace AppendRawLines with an owned AppendLog type","parent":"ARCHIMP-S19","type":"task","scope":["internal/adapters/files.go","internal/adapters/files_test.go","internal/adapters/append_log_test_helpers.go (new)","internal/ops/opstream.go","internal/materialize/pipeline.go"],"acceptance":["TestAppendLogAppend_REQ_ARCHIMP_S19_T2 passes","TestAppendLogTornWriteRecovery_REQ_ARCHIMP_S19_T2 passes","AppendRawLines no longer exists in internal/adapters","make check green"],"definition_of_done":"AppendRawLines is removed and replaced by an AppendLog type in internal/adapters (package internal/adapters, not internal/ops) that owns the .pending crash-recovery marker protocol. AppendLog is constructed fresh per call (no persistent handle) and exposes only production behavior (e.g. an Append method); crash/torn-write simulation is exposed via a separate test-only helper file, used by both files_test.go and the relocated internal/materialize/replay_test.go (ARCHIMP-S19-T3) to construct .pending fixtures, replacing today's two independent hand-rolled hardcoded fixtures. Callers in internal/ops (AppendOp) and internal/materialize/pipeline.go call AppendLog directly.","priority":"high","confidence":"draft"}]
["create","ARCHIMP-S19-T3",1784509899,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Relocate replay_test.go from internal/e2eharness to internal/materialize","parent":"ARCHIMP-S19","type":"task","scope":["internal/e2eharness/replay_test.go","internal/materialize/replay_test.go (new)"],"acceptance":["internal/e2eharness/replay_test.go no longer exists","internal/materialize/replay_test.go exists with package materialize","make check green"],"definition_of_done":"replay_test.go moves from internal/e2eharness to internal/materialize with its package clause changed from e2eharness_test to materialize (white-box), matching the dominant convention in internal/materialize (5 of 6 existing test files use white-box package materialize). The relocated test uses the shared torn-write fixture helper introduced in ARCHIMP-S19-T2 instead of its current hand-rolled hardcoded \".pending\" construction. No cross-referencing doc note tying together the other scattered 'replay' concepts is added — explicitly out of scope.","priority":"medium","confidence":"draft"}]
