["create","AOC-S2-T3",1787543046,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"arm show conforms to the contract","parent":"AOC-S2","type":"task","scope":["cmd/armature/show.go","cmd/armature/show_test.go"],"acceptance":["TestShowHonoursStructuredFormat_REQ_AOC_S2_T3 passes","TestShowTruncatesOutcomeWithSizeHint_REQ_AOC_S2_T3 passes","TestShowFullFlagReturnsCompleteField_REQ_AOC_S2_T3 passes","make check green"],"definition_of_done":"arm show honours the structured contract instead of falling through to human prose, emitting the envelope on stdout. outcome and other large text fields are truncated by default with the total size stated and a --full escape hatch offered only when content was actually truncated. This is the detail view that arm list's help[] directs agents to, so the truncation limit is chosen to cover the common case in one call.","context_files":["docs/design/agent-output-contract.md"],"priority":"high","confidence":"draft"}]
