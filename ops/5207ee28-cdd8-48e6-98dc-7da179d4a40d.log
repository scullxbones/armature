["create","ARCHIMP-S18-T4",1783257748,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Restore Command Runtime as the only execution-state seam","parent":"ARCHIMP-S18","type":"task","scope":["cmd/armature/main.go","cmd/armature/helpers.go","cmd/armature/main_test.go","cmd/armature/architecture_test.go","cmd/armature/sources.go","cmd/armature/workers.go","cmd/armature/materialize.go","cmd/armature/log.go","cmd/armature/sync.go","cmd/armature/context_history.go","cmd/armature/doctor.go","cmd/armature/tui.go","cmd/armature/harness_context.go","cmd/armature/harness_hook.go","cmd/armature/validate.go","cmd/armature/dagsum.go","cmd/armature/hook.go","cmd/armature/transition.go","cmd/armature/confirm.go","cmd/armature/reparent.go","cmd/armature/scope_delete.go","cmd/armature/scope_rename.go","cmd/armature/stalereview.go","cmd/armature/decompose.go","cmd/armature/render_context.go"],"acceptance":["TestCommandRuntimeIsolation_REQ_ARCHIMP_S18_T4 proves independent root commands cannot observe each other's execution state","TestNoGlobalCommandRuntime_REQ_ARCHIMP_S18_T4 fails on production appCtx, appPusher, or appTracker declarations or reads","all command integration tests preserve existing output and exit behavior","make check exits 0"],"definition_of_done":"All production commands obtain repository context, pusher, tracker, and Snapshot access through explicit execution state in the Cobra context. Process-global command state and fallback behavior are removed, architecture enforcement prevents recurrence, and independent root commands remain isolated.","context_files":["docs/superpowers/specs/2026-07-04-active-architecture-seams-prd.md","docs/design/architecture.md","docs/adr/0004-deep-module-depguard-boundaries.md"],"priority":"high","confidence":"draft"}]
