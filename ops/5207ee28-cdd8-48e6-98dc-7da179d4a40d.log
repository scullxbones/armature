["create","AOC-S4-T2",1787543046,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Dogfood finding: worker thrash on repeated identical done reports","parent":"AOC-S4","type":"task","scope":["docs/dogfood/findings/raw/"],"acceptance":["Finding file exists under docs/dogfood/findings/raw/ following the documented naming convention","make check green"],"definition_of_done":"A raw dogfood finding records the worker-thrash pattern with its evidence: ORCH-RUNTIME-V1-T3 emitting six byte-identical empty-outcome done transitions inside 15 minutes, plus the corpus-wide rate of 14 true duplicates across 1,367 transition ops. The finding names the harness behaviour as the defect rather than the ops log, so that once payload-keyed idempotency suppresses the ops, the underlying loop is still visible as a tracked concern.","context_files":["docs/agents/dogfood-findings.md"],"priority":"low","confidence":"draft"}]
