["create","AOC-S1-T3",1787745859,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Mode-sensitive Artifact Output classification","parent":"AOC-S1","type":"task","scope":["internal/output/classify.go","internal/output/classify_test.go","cmd/armature/review.go","cmd/armature/review_test.go","cmd/armature/cmd_completion.go","cmd/armature/cmd_completion_test.go","cmd/armature/decompose.go","cmd/armature/cmd_extra_test.go"],"acceptance":["TestArtifactOutputClassificationIsModeSensitive_REQ_AOC_S1_T3 passes","TestArtifactOutputModesCiteGoverningShape_REQ_AOC_S1_T3 passes","TestArtifactCommandsKeepResultModesAgentFacing_REQ_AOC_S1_T3 passes","make check green"],"definition_of_done":"The output classifier adds explicit, cited Artifact Output alongside agent-facing and Protocol Output. Classification is mode-sensitive: the three normative artifact modes opt out, while other modes of the same commands remain agent-facing. Existing output bytes do not change.","context_files":["docs/design/agent-output-contract.md","docs/schemas/review-bundle.schema.json","docs/commands.md"],"priority":"high","confidence":"draft"}]
