["create","HOOKBIND-T5",1783090251,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Update harness-hook docs and coordinator skill for mandatory worktrees and violation gate","parent":"HOOKBIND","type":"task","scope":["docs/harness-hook.md",".claude/skills/armature-coordinator/SKILL.md"],"acceptance":["docs/harness-hook.md describes the resolution chain matching ADR-0007","grep -q 'required' .claude/skills/armature-coordinator/SKILL.md for worktree dispatch","arm validate exits 0"],"definition_of_done":"docs/harness-hook.md documents the four-step resolution chain, worktree-local decision log format, violation gate, and fail-open posture. Coordinator skill states --worktree on claim is required for dispatch (invariant rationale, not only permissions) and that a wave with violation: entries must not be integrated without explicit operator override.","context_files":["docs/adr/0007-path-based-issue-binding-resolution.md"],"priority":"medium","confidence":"draft"}]
