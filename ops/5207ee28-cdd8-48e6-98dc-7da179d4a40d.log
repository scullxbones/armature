["create","AOC-S4",1787543046,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Payload-keyed op idempotency","parent":"AOC","type":"story","acceptance":["All child tasks merged","arm validate passes with no errors"],"definition_of_done":"Re-issuing a mutation that cannot change materialized state is a no-op at exit 0 that appends nothing, while a repeat carrying new information is recorded as an amendment. Measured against the current 9,172-op corpus: suppresses 14 true duplicates, preserves all 29 amendments.","priority":"medium","confidence":"draft"}]
