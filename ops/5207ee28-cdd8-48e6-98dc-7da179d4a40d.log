["create","AOC-S2-T1",1787543046,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"arm ready conforms to the contract","parent":"AOC-S2","type":"task","scope":["cmd/armature/ready.go","cmd/armature/ready_test.go"],"acceptance":["TestReadyEmitsEnvelopeOnStdout_REQ_AOC_S2_T1 passes","TestReadyExpiredClaimsInEnvelopeNotStderr_REQ_AOC_S2_T1 passes","TestReadyEmptyStateIsDefinitive_REQ_AOC_S2_T1 passes","make check green"],"definition_of_done":"arm ready emits {count, issues[], help[]} on stdout. Expired claims move off stderr into the envelope as a named field rather than a separate stderr array, closing the case where an agent running 2\u003e/dev/null silently loses them. An empty ready queue is a definitive empty state carrying the zero and its context, not a bare []. The --waves shape is folded into the same envelope.","context_files":["docs/design/agent-output-contract.md"],"priority":"high","confidence":"draft"}]
