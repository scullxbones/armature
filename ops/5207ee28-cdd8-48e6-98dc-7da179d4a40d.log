["create","HOOKBIND",1783090251,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Harness hook: path-based issue binding resolution per ADR-0007","type":"story","definition_of_done":"Harness hook resolves issue bindings per the ADR-0007 chain, every decision is logged worktree-locally, all failure paths are fail-open with loud messaging, arm merged gates on violations, and Task-\u003eIssue rename is complete across code, disk, env, and docs.","priority":"high","confidence":"draft"}]
["create","HOOKBIND-T1",1783090251,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Rename Task Binding to Issue Binding across code, disk, env, and docs","parent":"HOOKBIND","type":"task","scope":["internal/harnesspolicy/resolver.go","internal/harnesspolicy/resolver_test.go","internal/harnesshook/hook.go","internal/harnesshook/hook_test.go","internal/harnesshook/launcher.go","internal/harnesshook/launcher_test.go","internal/harnesshook/types.go","cmd/armature/harness_hook.go","cmd/armature/harness_hook_test.go","cmd/armature/claim.go","cmd/armature/claim_test.go","cmd/armature/merged.go","cmd/armature/merged_test.go","docs/harness-hook.md","docs/commands.md"],"acceptance":["TestResolveIssueBinding_REQ_HOOKBIND_T1 passes","grep -r 'armature-task-id\\|ARMATURE_TASK_ID' --include='*.go' returns no matches","make check green"],"definition_of_done":"All task-binding vocabulary is renamed to issue binding: binding file is armature-issue-id, env var is ARMATURE_ISSUE_ID, Go identifiers use Issue (e.g. resolveIssueBinding, IssuePolicy). Clean cut, no backward-compat fallback for old file or env names. Docs updated to match. All existing tests pass.","context_files":["docs/adr/0007-path-based-issue-binding-resolution.md","CONTEXT.md"],"priority":"high","confidence":"draft"}]
["create","HOOKBIND-T2",1783090251,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Implement path-based binding resolution chain in arm harness-hook","parent":"HOOKBIND","type":"task","scope":["cmd/armature/harness_hook.go","cmd/armature/harness_hook_test.go","internal/harnesshook/binding.go (new)","internal/harnesshook/binding_test.go (new)","internal/harnesshook/types.go"],"acceptance":["TestBindingResolutionChain_REQ_HOOKBIND_T2 passes","TestFilePathWalkUpResolvesWorktreeBinding_REQ_HOOKBIND_T2 passes","TestStopEventUsesSessionBinding_REQ_HOOKBIND_T2 passes","make check green"],"definition_of_done":"Binding resolves most-specific-first: (1) walk up from tool_input.file_path to a containing worktree git dir and its armature-issue-id, (2) event payload cwd, (3) hook process cwd, (4) ARMATURE_ISSUE_ID env. Event payload is decoded before binding resolution. Bash and Stop events resolve at session level (steps 3-4). Stop verification uses the session binding only.","context_files":["docs/adr/0007-path-based-issue-binding-resolution.md"],"priority":"high","confidence":"draft"}]
