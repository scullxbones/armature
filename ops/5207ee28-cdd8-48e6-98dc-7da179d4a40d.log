["create","LNGHZN-S5-T3",1784485922,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Project-type mitigations at worktree provision and lifecycle docs","parent":"LNGHZN-S5","type":"task","scope":["internal/worktree/mitigations.go (new)","internal/worktree/mitigations_test.go (new)","docs/agents/workflow.md"],"acceptance":["TestGoWorkMitigationApplied_REQ_LNGHZN_S5_T3 passes","make check green"],"definition_of_done":"Worktree provisioning applies known project-type mitigations — for Go projects, excluding the worktree from go.work-driven gopls diagnostics in the main tree. docs/agents/workflow.md documents the managed lifecycle (provision at claim, list/gc, teardown at merged) and retires the guidance treating worktrees as the agent's problem.","priority":"medium","confidence":"draft"}]
