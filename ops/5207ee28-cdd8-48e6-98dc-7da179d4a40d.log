["create","EXECEV-T4",1783091971,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Activity-index summarizer skill and coordinator wiring","parent":"EXECEV","type":"task","scope":[".claude/skills/armature-activity-indexer/SKILL.md (new)",".claude/skills/armature-coordinator/SKILL.md",".claude/skills/armature-reviewer/SKILL.md"],"acceptance":["armature-activity-indexer SKILL.md defines the index schema matching ADR-0008","armature-reviewer SKILL.md states upgrade-only and index-not-citable rules","arm validate exits 0"],"definition_of_done":"New armature-activity-indexer skill: cheap fresh-context subagent reads the activity log and emits a schema-constrained index (entry ID, command one-liner, exit status, HEAD-anchor flag, category, log pointer) carrying the log digest. Coordinator dispatches it between delivery and review and passes index plus bundle to the Reviewer. Reviewer skill documents the upgrade-only rule and that the index is never citable.","context_files":["docs/adr/0008-execution-evidence-in-semantic-review.md"],"priority":"medium","confidence":"draft"}]
