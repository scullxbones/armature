["create","HOOKBIND-T3",1783090251,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Worktree-local decision logging and universal fail-open posture","parent":"HOOKBIND","type":"task","scope":["cmd/armature/harness_hook.go","cmd/armature/harness_hook_test.go","internal/harnesshook/binding.go","internal/harnesshook/binding_test.go"],"acceptance":["TestDecisionLoggedToResolvedWorktree_REQ_HOOKBIND_T3 passes","TestUnboundFileWriteLogsViolation_REQ_HOOKBIND_T3 passes","TestSnapshotErrorFailsOpen_REQ_HOOKBIND_T3 passes","make check green"],"definition_of_done":"Every evaluated event appends one line to the resolved worktree's armature-hook.log: timestamp, issue ID, resolution step, event, tool, decision, block reason. File writes resolving to no binding log a violation: entry. Snapshot-load and event-decode errors become logged pass-throughs with loud stderr warnings instead of nonzero exits (fail-open everywhere). Nothing is ever written to the ops log.","context_files":["docs/adr/0007-path-based-issue-binding-resolution.md"],"priority":"high","confidence":"draft"}]
["link","HOOKBIND-T3",1783090251,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"dep":"HOOKBIND-T2","rel":"blocked_by"}]
["create","HOOKBIND-T4",1783090251,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"arm merged gates on violation entries in the hook log","parent":"HOOKBIND","type":"task","scope":["cmd/armature/merged.go","cmd/armature/merged_test.go"],"acceptance":["TestMergedFailsOnViolations_REQ_HOOKBIND_T4 passes","TestMergedForceOverridesViolations_REQ_HOOKBIND_T4 passes","TestMergedWarnsOnPassThrough_REQ_HOOKBIND_T4 passes","make check green"],"definition_of_done":"arm merged --issue exits non-zero without tearing down the worktree when its armature-hook.log contains violation: entries, unless --force is passed. pass-through: entries remain warnings only, as today.","context_files":["docs/adr/0007-path-based-issue-binding-resolution.md"],"priority":"medium","confidence":"draft"}]
