["create","EXECEV",1783091971,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Semantic review: harness-recorded execution evidence per ADR-0008","type":"story","definition_of_done":"Harness hooks capture a complete Bash activity log per bound issue; the Review Bundle carries an optional digest-referenced activity section; an activity-index skill produces a non-citable finding aid; arm review record validates activity citations against raw entry IDs; docs and reviewer/coordinator skills reflect the new evidence class; a sensitive-environments document states the disclosure posture loudly.","priority":"high","confidence":"draft"}]
["create","EXECEV-T1",1783091971,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Capture Bash execution evidence to worktree-local activity log","parent":"EXECEV","type":"task","scope":["cmd/armature/harness_hook.go","cmd/armature/harness_hook_test.go","internal/harnesshook/activity.go (new)","internal/harnesshook/activity_test.go (new)","internal/harnesshook/types.go"],"acceptance":["TestActivityCaptureBashPostToolUse_REQ_EXECEV_T1 passes","TestActivityCaptureTruncationAndHash_REQ_EXECEV_T1 passes","TestActivityCaptureKillSwitch_REQ_EXECEV_T1 passes","make check green"],"definition_of_done":"Bash PostToolUse events for a bound issue append (command, exit status, truncated output, full-output hash, worktree HEAD sha, timestamp) entries to worktree-local armature-activity.log. Capture-all: no command filtering; truncation is per-entry head+tail with marker. Repo-level config kill-switch disables capture. Never written to ops or committed. Fail-open on any capture error with stderr warning.","context_files":["docs/adr/0008-execution-evidence-in-semantic-review.md","docs/adr/0007-path-based-issue-binding-resolution.md"],"priority":"high","confidence":"draft"}]
["create","EXECEV-T2",1783091971,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Optional activity section in Review Bundle with digest and HEAD-anchor summary","parent":"EXECEV","type":"task","scope":["internal/review/prepare.go","internal/review/prepare_test.go","internal/review/types.go","internal/review/types_test.go","internal/review/fingerprint.go","internal/review/fingerprint_test.go"],"acceptance":["TestBundleActivitySection_REQ_EXECEV_T2 passes","TestBundleWithoutActivityLogUnchanged_REQ_EXECEV_T2 passes","TestAttestationCarriesActivityDigest_REQ_EXECEV_T2 passes","make check green"],"definition_of_done":"arm review prepare attaches an optional activity section when an activity log exists for the issue's worktree: log digest, entry count, HEAD-anchor summary (entries at delivery head vs earlier), and log path. Bundles without a log omit the section and are unchanged. Activity digest is included in the attestation payload.","context_files":["docs/adr/0008-execution-evidence-in-semantic-review.md","docs/superpowers/specs/2026-06-27-semantic-conformance-review-design.md"],"priority":"high","confidence":"draft"}]
["link","EXECEV-T2",1783091971,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"dep":"EXECEV-T1","rel":"blocked_by"}]
["create","EXECEV-T3",1783091971,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Validate activity citations against raw entry IDs in arm review record","parent":"EXECEV","type":"task","scope":["internal/review/validate.go","internal/review/validate_test.go","internal/review/acceptance.go","internal/review/acceptance_test.go","internal/review/render.go","internal/review/render_test.go"],"acceptance":["TestActivityCitationValidation_REQ_EXECEV_T3 passes","TestActivityDigestMismatchRejected_REQ_EXECEV_T3 passes","TestRenderExcludesRawOutput_REQ_EXECEV_T3 passes","make check green"],"definition_of_done":"Reviewer results may cite activity entries by raw entry ID; record rejects citations referencing the index, unknown entry IDs, or a log whose digest mismatches the bundle. Upgrade-only enforced structurally where derivable: activity citations alone cannot support satisfied on implementation criteria. Rendered reports show entry ID, command line, exit status - never raw output excerpts.","context_files":["docs/adr/0008-execution-evidence-in-semantic-review.md"],"priority":"high","confidence":"draft"}]
