["create","TOPTIER-S2-T3",1783426756,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Conventions page: _REQ_ test naming, commit format, branch naming","parent":"TOPTIER-S2","type":"task","scope":["docs/conventions.md (new)","skills/armature-worker/SKILL.md","skills/armature-planner/SKILL.md","skills/armature-coordinator/SKILL.md","AGENTS.md"],"acceptance":["docs/conventions.md exists and documents _REQ_ naming, commit format, branch naming","worker, planner, and coordinator skills link to docs/conventions.md","make validate-skills green"],"definition_of_done":"docs/conventions.md documents the Test\u003cDesc\u003e_REQ_\u003cISSUE-ID\u003e traceability convention, conventional-commit format with issue-id scope, and branch naming; worker, planner, and coordinator skills link to it so workers stop failing review on undocumented conventions.","context_files":["docs/design/top-tier-gap-analysis.md","docs/agents/quality-gates.md"],"priority":"medium","confidence":"draft"}]
["create","TOPTIER-S3",1783426756,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"End-to-end workflow test harness","parent":"TOPTIER","type":"story","definition_of_done":"A test harness spins up a bare origin plus multiple clones and drives the full lifecycle with real git; happy-path, claim-race, stale-claim, and crash-recovery scenarios run in CI; JSON artifacts round-trip under strict decoding. Closes gap T2 and T3.4.","priority":"high","confidence":"draft"}]
["create","TOPTIER-S3-T1",1783426756,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Test harness package with happy-path lifecycle test","parent":"TOPTIER-S3","type":"task","scope":["internal/e2eharness/harness.go (new)","internal/e2eharness/harness_test.go (new)","internal/e2eharness/lifecycle_test.go (new)","Makefile",".github/workflows/ci.yml"],"acceptance":["TestLifecycleHappyPath_REQ_TOPTIER-S3-T1 passes against the built arm binary","harness runs as a separate CI job","make check green"],"definition_of_done":"An e2eharness package creates a bare origin repo plus N clones, runs the built arm binary through bootstrap, worker-init, decompose-apply, dag-transition, claim, transition done, and merge detection, asserting materialized state at each step. Runs as a separate CI job so the unit loop stays fast.","context_files":["docs/design/top-tier-gap-analysis.md","docs/design/architecture.md"],"priority":"high","confidence":"draft"}]
