["create","LNGHZN-S10-T5",1786748962,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Detect cross-task gate coupling at plan release (vertical-slice rule)","parent":"LNGHZN-S10","type":"task","scope":["internal/validate/coupling.go (new)","internal/validate/coupling_test.go (new)","docs/design/gate-efficiency.md"],"acceptance":["TestPlanCouplingDetection_REQ_LNGHZN_S10_T5 passes","TestPlanCouplingCoLocatedScopePasses_REQ_LNGHZN_S10_T5 passes","make check green at task head"],"definition_of_done":"Plan validation fails when one task's scope touches a censused surface (cmd/**) while a different task in the same story owns the documentation or census files that surface's drift check reads (docs/commands.md, docs/design/surface-census.md). The error names both tasks and the coupled files and states the remedy: co-locate the census/doc lines with the code task.","context_files":["docs/design/gate-efficiency.md"],"priority":"medium","confidence":"draft"}]
