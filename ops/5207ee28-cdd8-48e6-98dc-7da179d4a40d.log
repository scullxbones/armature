["note","LNGHZN-S6",1787747810,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"msg":"Grill 2026-08-26 (grill-with-docs / HANDOFF-LNGHZN-S6): Command Failure is a port type; stdout {error:{code,cause,next_actions,exit_code}} not nested in AOC; expand-then-contract (GENERAL-1 wrap then T5 deletes it). ADR 0020. T4 remains extra TUI-seam work.","note_id":"note-1787747810238103755"}]
["note","LNGHZN-S6-T1",1787747810,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"msg":"Grill overturned AOC nesting and the AOC-S1-T2 blocker. Render stays in cmd (helpers.go), not internal/output. Unmapped RunE errors wrap as GENERAL-1 until T5. Delete ArmatureError. Do not import internal/errors from depguard-bounded packages.","note_id":"note-1787747810404832717"}]
["note","LNGHZN-S6-T2",1787747810,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"msg":"Map at the CLI port from ordinary core errors. Prefix = deep module (ADR 0011) or Use if no module. Light-hand next_actions; exact argv is not required. High-traffic only — remaining sites are T5.","note_id":"note-1787747810555852169"}]
["note","LNGHZN-S6-T3",1787747810,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"msg":"Ledger in docs/error-contract.md is the no-repurpose guardrail (make check, census-shaped). Prefix test: non-reserved prefixes are ToUpper(module basename) or ToUpper(top-level Use). Do not assert every RunE is mapped — that is T5.","note_id":"note-1787747810703309957"}]
["note","LNGHZN-S6-T4",1787747810,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"msg":"When extracting *_tui.go, preserve any Command Failure returns T2 already put on the non-interactive path in ready.go. This task is not part of the LH C3 error contract.","note_id":"note-1787747810862676565"}]
["decision","LNGHZN-S6",1787747811,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"topic":"agent-error-contract","choice":"port-type Command Failure; sibling stdout object; expand-then-contract; module-prefix codes; ledger in make check","rationale":"Ratified 2026-08-26 grilling. Core stays free of CLI vocabulary (ADR 0004). Failures are not AOC success envelopes (ADR 0017). GENERAL-1 wrap is a temporary uniform envelope, not a permanent classifier. See ADR 0020.","affects":["cmd/armature/main.go","cmd/armature/helpers.go","internal/errors/errors.go"]}]
