["create","AOC-S2-T2",1787543046,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"arm list conforms to the contract","parent":"AOC-S2","type":"task","scope":["cmd/armature/list.go","cmd/armature/list_test.go"],"acceptance":["TestListDefaultRowIsFourFields_REQ_AOC_S2_T2 passes","TestListOmitsOutcome_REQ_AOC_S2_T2 passes","TestListGroupHonouredInStructuredOutput_REQ_AOC_S2_T2 passes","TestListCountIsTrueTotal_REQ_AOC_S2_T2 passes","make check green"],"definition_of_done":"arm list emits {count, issues[], help[]} on stdout with a default row of id, type, status, title. outcome is omitted from list output entirely rather than truncated, because the detail view already exists. count is the true total and the list is not capped. help[] trails the list pointing at arm show for detail. --group produces grouped structured output rather than being silently ignored. An empty result is a definitive empty state.","context_files":["docs/design/agent-output-contract.md"],"priority":"high","confidence":"draft"}]
