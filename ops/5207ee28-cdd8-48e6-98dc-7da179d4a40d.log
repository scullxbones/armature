["create","EXECEV-T5",1783091971,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Docs: spec amendment, harness-hook activity capture, sensitive-environments document","parent":"EXECEV","type":"task","scope":["docs/superpowers/specs/2026-06-27-semantic-conformance-review-design.md","docs/harness-hook.md","docs/sensitive-environments.md (new)"],"acceptance":["docs/sensitive-environments.md exists and documents the kill-switch and disclosure path","spec Non-Goals section references ADR-0008 amendment","arm validate exits 0"],"definition_of_done":"Spec Non-Goals and Architecture amended to reference ADR-0008 (execution evidence admissible, upgrade-only; hooks still never initiate or gate review). harness-hook.md documents activity capture, truncation, kill-switch, and the teardown-after-record ordering constraint. New docs/sensitive-environments.md loudly states the disclosure path (raw log to reviewer to report to PR surface), what published reports include and exclude, and how to disable capture.","context_files":["docs/adr/0008-execution-evidence-in-semantic-review.md"],"priority":"medium","confidence":"draft"}]
