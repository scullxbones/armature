["create","ARCHIMP-S18",1783257748,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Deepen active review, Source, runtime, and Snapshot seams","parent":"ARCHIMP","type":"story","scope":["cmd/armature/review.go","cmd/armature/sources.go","cmd/armature/main.go","cmd/armature/helpers.go","cmd/armature/architecture_test.go","internal/review","internal/sources","internal/snapshot"],"acceptance":["All child tasks are merged with recorded outcomes","make check exits 0","arm validate --ci exits 0","arm doctor exits 0"],"definition_of_done":"Conformance Recording, Source Lifecycle, Command Runtime, and Repository Snapshot each expose one deep interface used by production callers. Prior ARCHIMP outcomes remain intact, user-visible behavior is preserved, and make check, arm validate --ci, and arm doctor are green.","context_files":["docs/superpowers/specs/2026-07-04-active-architecture-seams-prd.md","docs/design/architecture.md","docs/adr/0004-deep-module-depguard-boundaries.md","docs/adr/0005-semantic-conformance-review-boundary.md","docs/adr/0008-execution-evidence-in-semantic-review.md"],"priority":"high","confidence":"draft"}]
["create","ARCHIMP-S18-T1",1783257748,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Deepen Conformance Recording into one review decision","parent":"ARCHIMP-S18","type":"task","scope":["cmd/armature/review.go","cmd/armature/review_test.go","internal/review/record.go (new)","internal/review/record_test.go (new)","internal/review/validate.go","internal/review/validate_test.go"],"acceptance":["TestRecordAssessmentDecision_REQ_ARCHIMP_S18_T1 passes for reject, duplicate, and attest outcomes","review command adapter tests prove file or stdin decoding, output, and Op persistence","existing semantic-review conformance tests remain green","make check exits 0"],"definition_of_done":"The review module owns assessment structure, bundle identity, fingerprint, diff-citation, Task Contract coverage, duplicate, and attestation decisions. The review command only decodes input, renders output, and appends the resulting Op. ADR-0005 and ADR-0008 behavior is preserved.","context_files":["docs/superpowers/specs/2026-07-04-active-architecture-seams-prd.md","docs/adr/0005-semantic-conformance-review-boundary.md","docs/adr/0008-execution-evidence-in-semantic-review.md"],"priority":"high","confidence":"draft"}]
["create","ARCHIMP-S18-T2",1783257748,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Deepen Source Lifecycle across commands and consumers","parent":"ARCHIMP-S18","type":"task","scope":["cmd/armature/sources.go","cmd/armature/sources_test.go","cmd/armature/create.go","cmd/armature/source_link.go","cmd/armature/stalereview.go","internal/sources/lifecycle.go (new)","internal/sources/lifecycle_test.go (new)","internal/sources/manifest.go","internal/sources/types.go","internal/decompose/context.go","internal/harnesspolicy/resolver.go"],"acceptance":["TestSourceLifecycleSyncAndVerify_REQ_ARCHIMP_S18_T2 passes for OK, STALE, MISSING, CHANGED, partial-success, and total-failure outcomes","filesystem and fake HTTP adapters cover provider variation without live network access","Source commands preserve existing human and structured behavior","make check exits 0"],"definition_of_done":"One Source Lifecycle module owns registration, manifest and cache persistence, fingerprinting, synchronization state, and freshness. Source commands and policy or context consumers cross that interface; filesystem, Confluence, and SharePoint remain adapters; provenance Ops are unchanged.","context_files":["docs/superpowers/specs/2026-07-04-active-architecture-seams-prd.md","docs/design/architecture.md"],"priority":"high","confidence":"draft"}]
["create","ARCHIMP-S18-T3",1783257748,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Collapse Repository Snapshot access modes","parent":"ARCHIMP-S18","type":"task","scope":["internal/snapshot/snapshot.go","internal/snapshot/snapshot_test.go","cmd/armature/helpers.go","cmd/armature/architecture_test.go","cmd/armature/review.go","cmd/armature/sync.go","cmd/armature/reparent.go","cmd/armature/harness_hook.go","cmd/armature/harness_context.go","cmd/armature/ready.go","cmd/armature/show.go","internal/tui/app/model.go"],"acceptance":["TestSnapshotCurrentTruthAccess_REQ_ARCHIMP_S18_T3 passes for read-only, refresh, warnings, and empty-repository behavior","TestHandlersUseSnapshotAccess_REQ_ARCHIMP_S18_T3 rejects direct current-state loading and premature materialization","show, ready, review, Render Context, Harness Hook, and TUI regression tests remain green","make check exits 0"],"definition_of_done":"Repository Snapshot owns current-truth loading, validated Op warnings, state paths, caching, read-only access, refresh, and freshness policy. Direct current-state loads are removed from commands and TUI callers; historical materialization stays separate; architecture enforcement catches regressions.","context_files":["docs/superpowers/specs/2026-07-04-active-architecture-seams-prd.md","docs/design/architecture.md","docs/adr/0004-deep-module-depguard-boundaries.md"],"priority":"high","confidence":"draft"}]
