["create","LNGHZN-S3",1784485922,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Autonomic heartbeats via the harness hook (LH C1)","parent":"LNGHZN","type":"story","acceptance":["All child tasks merged","arm validate passes with no errors"],"definition_of_done":"The harness hook emits rate-limited claim heartbeats on tool-call interception for bound workers, so a claim never goes stale while the agent is actively working and a stale claim reliably signals a dead worker. Docs and worker skill describe the new semantics.","priority":"high","confidence":"draft"}]
["create","LNGHZN-S3-T1",1784485922,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Emit rate-limited heartbeat ops from harness-hook interception","parent":"LNGHZN-S3","type":"task","scope":["internal/harnesshook/evaluator.go","internal/harnesshook/heartbeat.go (new)","internal/harnesshook/heartbeat_test.go (new)"],"acceptance":["TestHookEmitsRateLimitedHeartbeat_REQ_LNGHZN_S3_T1 passes","TestHookSkipsHeartbeatWhenUnbound_REQ_LNGHZN_S3_T1 passes","make check green"],"definition_of_done":"When the harness hook fires for a worker bound to an actively claimed issue, it appends a heartbeat op for that claim at most once per rate-limit interval (default a few minutes, constant in code). No heartbeat is emitted when unbound, when the binding is stale, or within the rate-limit window. Failures to heartbeat never block the underlying tool call.","context_files":["docs/harness-hook.md"],"priority":"high","confidence":"draft"}]
["create","LNGHZN-S3-T2",1784485922,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Document autonomic-heartbeat staleness semantics in docs and worker skill","parent":"LNGHZN-S3","type":"task","scope":["docs/harness-hook.md","internal/skillsembed/skills/armature-worker/SKILL.md"],"acceptance":["docs/harness-hook.md has an autonomic-heartbeats section consistent with the shipped behavior","make check green (skill lint/golden transcripts pass)"],"definition_of_done":"docs/harness-hook.md describes automatic heartbeats, the rate limit, and the new meaning of a stale claim (worker actually dead, not merely quiet). The worker skill drops any guidance telling workers to manually heartbeat during active tool use, keeping manual heartbeat only for long non-tool thinking stretches.","priority":"medium","confidence":"draft"}]
