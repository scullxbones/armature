["create","LNGHZN-S10-T7",1786752463,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"arm validate must use the fixed overlap matcher, not its own duplicate copy","parent":"LNGHZN-S10","type":"task","scope":["internal/validate/validate.go"],"definition_of_done":"internal/validate/validate.go no longer defines its own globOverlaps/globOverlapDir pair with the directory-ancestry fallback. Overlap matching is delegated to the single fixed implementation so validate and claim cannot diverge again. Distinct files sharing only a containing or ancestor directory stop being reported as overlaps.","priority":"high","confidence":"draft"}]
["amend","LNGHZN-S10-T7",1786752464,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"scope":["internal/validate/validate.go","internal/validate/validate_test.go"],"acceptance":["TestGlobOverlapsIgnoresSharedAncestorDirectory_REQ_LNGHZN_S10_T7: within internal/validate, docs/agents/quality-gates.md vs docs/use-cases.md reports NO overlap","The duplicate globOverlaps/globOverlapDir definitions are removed from internal/validate/validate.go and matching is delegated to the single fixed implementation","arm validate scope-overlap warning count drops substantially from its pre-fix value of 196, and every surviving warning names the same path on both sides rather than two different paths","make check is green"]}]
