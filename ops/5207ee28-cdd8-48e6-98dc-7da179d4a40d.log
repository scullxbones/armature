["create","AOC-S3-T5",1787543046,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"ADR 0019: park TOON with a re-entry criterion","parent":"AOC-S3","type":"task","scope":["docs/adr/0019-park-toon-output-format.md (new)","docs/design/agent-output-contract.md"],"acceptance":["ADR 0019 exists with an explicit re-entry criterion in context-report units","make validate-doc-examples green","make check green"],"definition_of_done":"ADR 0019 records TOON as parked, not rejected, using the park-not-purge vocabulary of ADR 0010. It states the measured basis and the costs that made it a park, and its re-entry criterion is expressed in the units make context-report now emits so it can be evaluated mechanically rather than re-argued.","context_files":["docs/design/agent-output-contract.md","docs/adr/0010-park-not-purge-subtractive-release.md"],"priority":"medium","confidence":"draft"}]
