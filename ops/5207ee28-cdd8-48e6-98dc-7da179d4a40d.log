["create","LNGHZN-S4",1784485922,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Transition-time delivery gate (LH C4)","parent":"LNGHZN","type":"story","acceptance":["All child tasks merged","arm validate passes with no errors"],"definition_of_done":"arm transition --to done verifies the bound worktree before appending the op: clean working tree, no untracked build artifacts, delivery diff within declared scope, and at least one commit referencing the issue ID. Failures return actionable remediations. Docs and worker skill updated.","priority":"high","confidence":"draft"}]
["create","LNGHZN-S4-T1",1784485922,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Delivery-gate check package: clean tree, scope containment, commit reference","parent":"LNGHZN-S4","type":"task","scope":["internal/deliverygate/gate.go (new)","internal/deliverygate/gate_test.go (new)"],"acceptance":["TestDeliveryGateCleanTree_REQ_LNGHZN_S4_T1 passes","TestDeliveryGateScopeContainment_REQ_LNGHZN_S4_T1 passes","TestDeliveryGateCommitReference_REQ_LNGHZN_S4_T1 passes","make check green"],"definition_of_done":"A new internal/deliverygate package evaluates a worktree against an issue: working tree clean, no untracked build artifacts, diff vs base is a subset of declared scope (glob-aware, same primitive as claim overlap), and at least one commit message references the issue ID. Returns a structured result listing each failed check with a remediation string; performs no state mutation.","context_files":["internal/claim/overlap.go"],"priority":"high","confidence":"draft"}]
["create","LNGHZN-S4-T2",1784485922,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Wire the delivery gate into arm transition --to done","parent":"LNGHZN-S4","type":"task","scope":["cmd/armature/transition.go","cmd/armature/transition_gate_test.go (new)"],"acceptance":["TestTransitionDoneBlockedByGate_REQ_LNGHZN_S4_T2 passes","TestTransitionDoneGateOverride_REQ_LNGHZN_S4_T2 passes","make check green"],"definition_of_done":"arm transition --to done runs the delivery gate in the bound worktree before appending the op and refuses with per-check remediations on failure. An explicit override flag (e.g. --skip-delivery-gate) exists for legitimate exceptions and is recorded in the transition op's note. Transitions to other states are unaffected.","priority":"high","confidence":"draft"}]
