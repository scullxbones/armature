["create","TOPTIER-S2-T2",1783426756,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Embed CLI-generated canonical examples into skills at build time","parent":"TOPTIER-S2","type":"task","scope":["scripts/embed_examples.py (new)","Makefile","skills/armature-planner/SKILL.md","internal/skillsembed/"],"acceptance":["make validate-skills fails when embedded example diverges from arm decompose-apply --example","planner skill example includes acceptance fields and the version/title/issues wrapper","make check green"],"definition_of_done":"The planner skill's plan JSON example is generated from arm decompose-apply --example output at build time (with acceptance fields added), and make validate-skills fails if the embedded example diverges from current CLI output, eliminating example drift.","context_files":["docs/design/top-tier-gap-analysis.md"],"priority":"medium","confidence":"draft"}]
