["create","LNGHZN-B1",1783511561,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Sources lifecycle does not auto-commit manifest/cache changes","parent":"LNGHZN","type":"bug","scope":["cmd/armature/sources.go","internal/sources/lifecycle.go","internal/sources/manifest.go"],"acceptance":["TestSourcesAdd_AutoCommits_REQ_LNGHZN_B1 passes","TestSourcesSync_AutoCommits_REQ_LNGHZN_B1 passes","manual repro: arm sources add/sync leaves _armature worktree clean (git status --porcelain empty) immediately after the command exits","make check green"],"definition_of_done":"arm sources add/sync/verify auto-commit their writes to the _armature branch the same way ops writes already do via ops.AppendAndCommit, so manifest.json and .cache files never sit uncommitted after a sources command completes.","priority":"high","confidence":"draft"}]
["create","LNGHZN-S1",1783511561,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Collapse the .arm/.armature/ double-dotdir","parent":"LNGHZN","type":"story","scope":["cmd/armature/bootstrap.go","internal/config/context.go","internal/context/assemble.go","internal/review/prepare.go","internal/adapters/git.go","AGENTS.md","docs/design/architecture.md","docs/agents/"],"acceptance":["TestBootstrap_CollapsesDualBranchLayout_REQ_LNGHZN_S1 passes","TestBootstrap_ChainsLegacyToCollapsed_REQ_LNGHZN_S1 passes","arm doctor and arm validate exit 0 after migration on a fixture repo","make check green"],"definition_of_done":"Ops coordination state lives at a single .armature/ worktree (no inner .armature/ subdir); arm bootstrap migrates any of the three prior layouts (legacy single-branch, today's dual-branch .arm/.armature/, or already-collapsed) to the collapsed layout in one idempotent pass with backup/rollback; non-bootstrap commands refuse to operate on an unmigrated repo with a clear message to run bootstrap; docs and bundled skills describe the new layout.","priority":"high","confidence":"draft"}]
["link","LNGHZN-S1",1783511561,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"dep":"LNGHZN-B1","rel":"blocked_by"}]
["create","LNGHZN-S1-T1",1783511561,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Introduce StateDirName constant and refactor hardcoded .armature/.arm literals","parent":"LNGHZN-S1","type":"task","scope":["internal/config/context.go","internal/context/assemble.go","internal/review/prepare.go","cmd/armature/bootstrap.go"],"acceptance":["grep for hardcoded \".armature\" literals in the touched files returns only the constant definition","make check green"],"definition_of_done":"A single StateDirName = \".armature\" constant in internal/config replaces the hardcoded \".armature\"/\".arm\" string literals in config/context.go, context/assemble.go, review/prepare.go, and bootstrap.go.","priority":"high","confidence":"draft"}]
["create","LNGHZN-S1-T2",1783511561,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Implement the dual-branch to collapsed-layout migration in bootstrap","parent":"LNGHZN-S1","type":"task","scope":["cmd/armature/bootstrap.go","internal/adapters/git.go"],"acceptance":["TestBootstrap_CollapsesDualBranchLayout_REQ_LNGHZN_S1_T2 passes","TestBootstrap_RefusesDirtyWorktree_REQ_LNGHZN_S1_T2 passes","TestBootstrap_RollsBackOnFailure_REQ_LNGHZN_S1_T2 passes","make check green"],"definition_of_done":"arm bootstrap detects today's .arm/.armature/ layout, backs up .arm/ to a timestamped .arm.collapsed-\u003ctimestamp\u003e directory, removes and re-adds the ops worktree at .armature/ with contents flattened (state/ folded to .armature/state/\u003cworkerID\u003e), swaps the .git/info/exclude line from .arm/ to .armature/, and rolls back to the pre-migration state on any failure. Refuses to run if the _armature worktree has uncommitted changes.","priority":"high","confidence":"draft"}]
["link","LNGHZN-S1-T2",1783511561,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"dep":"LNGHZN-S1-T1","rel":"blocked_by"}]
