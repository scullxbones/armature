["create","NXTTN-S3",1784485922,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Context Economics — token budgets as a governed gate (№03)","parent":"NXTTN","type":"story","acceptance":["All child tasks merged","arm validate passes with no errors"],"definition_of_done":"Tokens are a governed budget the way coverage already is: make context-report prices every agent-facing artifact (skills, glossary, key docs), per-class budgets with a ratchet are enforced by a check wired into make check, and the coordinator skill is trimmed as the first application.","priority":"high","confidence":"draft"}]
