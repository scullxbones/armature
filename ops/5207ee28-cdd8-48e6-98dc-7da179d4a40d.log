["create","LNGHZN-S6",1784485922,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Agent-grade error contract (LH C3)","parent":"LNGHZN","type":"story","acceptance":["All child tasks merged","arm validate passes with no errors"],"definition_of_done":"arm errors carry a stable code, one-line cause, and machine-actionable remediation; in --format agent a structured next_actions field names the exact command to run. High-traffic commands migrated; the contract is documented and enforced by test.","priority":"high","confidence":"draft"}]
["create","LNGHZN-S6-T1",1784485922,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Structured error type with code, cause, and next_actions rendering","parent":"LNGHZN-S6","type":"task","scope":["internal/errors/errors.go","internal/errors/errors_test.go","internal/output/agent_error.go (new)","internal/output/agent_error_test.go (new)"],"acceptance":["TestStructuredErrorAgentEnvelope_REQ_LNGHZN_S6_T1 passes","TestStructuredErrorHumanRendering_REQ_LNGHZN_S6_T1 passes","make check green"],"definition_of_done":"internal/errors gains a structured error type carrying a stable code (registry constant), one-line cause, and a next_actions list of concrete commands. Human format renders code + cause + remediation lines; --format agent renders a JSON envelope with code, cause, and next_actions. Errors without the type render unchanged.","priority":"high","confidence":"draft"}]
