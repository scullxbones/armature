["create","TOPTIER-S1-T1",1783426756,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Skill lint: verify fenced skill commands against the real CLI in CI","parent":"TOPTIER-S1","type":"task","scope":["scripts/skill_lint.py (new)","Makefile",".github/workflows/ci.yml","skills/"],"acceptance":["skill-lint step runs in make check and CI and exits 0","seeded drift (removed --worktree from a fenced claim example) makes skill-lint fail","TestSkillLint_REQ_TOPTIER-S1-T1 passes"],"definition_of_done":"A skill-lint step extracts arm command invocations from fenced code blocks in every skills/ SKILL.md and verifies against the built CLI that each subcommand exists, all flags used are valid, and mandatory flags (e.g. claim --worktree) are present. Runs in make check and CI; fails on the known historical drift classes.","context_files":["docs/design/top-tier-gap-analysis.md","docs/agents/skills.md"],"priority":"high","confidence":"draft"}]
["create","TOPTIER-S1-T2",1783426756,"5207ee28-cdd8-48e6-98dc-7da179d4a40d",{"title":"Golden-transcript e2e test for coordinator wave dispatch","parent":"TOPTIER-S1","type":"task","scope":["internal/skilltranscript/golden_test.go (new)","internal/skilltranscript/harness.go (new)","Makefile"],"acceptance":["TestCoordinatorTranscript_REQ_TOPTIER-S1-T2 passes in CI","transcript covers ready, claim --worktree, render-context, transition done, review prepare/record","make check green"],"definition_of_done":"A CI test drives the coordinator skill's documented command sequence (ready, claim --worktree, render-context, transition done, review prepare/record) verbatim against a fixture repo and asserts each step succeeds, so skill/CLI drift breaks the build instead of a live wave.","context_files":["docs/design/top-tier-gap-analysis.md"],"priority":"high","confidence":"draft"}]
