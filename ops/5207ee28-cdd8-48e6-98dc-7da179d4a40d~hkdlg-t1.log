["citation-accepted","HKDLG-T1",1788828379,"5207ee28-cdd8-48e6-98dc-7da179d4a40d~hkdlg-t1",{"confirmed_noninteractively":true,"rationale":"Sourced from HOOKMSG-1 dogfood finding: post-commit shell calls bare arm heartbeat which prints GENERAL-1 on stdout; native runPostCommitHook already implements claim-aware heartbeat."}]
["note","HKDLG-T1",1788828536,"5207ee28-cdd8-48e6-98dc-7da179d4a40d~hkdlg-t1",{"msg":"Shell post-commit no longer calls arm push-ops once the template delegates to arm hook run. Native runPostCommitHook comments mention push-ops but does not call it. Re-adding push-ops in Go is out of T1 scope.","note_id":"note-1788828536528935135"}]
["note","HKDLG-T1",1788828978,"5207ee28-cdd8-48e6-98dc-7da179d4a40d~hkdlg-t1",{"msg":"runPostCommitHook skips using parent RepoPath, so a post-commit fired from the _armature ops worktree (AppendAndCommit) re-enters and recurses. T1 e2e disables ops-worktree hooks via core.hooksPath; T2 should skip on the hook checkout branch. Shell push-ops is gone with the delegated template; re-adding it in Go is out of T1 scope.","note_id":"note-1788828978210835461"}]
