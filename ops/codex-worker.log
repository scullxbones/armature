["create","ORCRUN-T01",1780450256,"codex-worker",{"title":"Define orchestration run and preflight contracts","parent":"ORCRUN-S1","type":"task","scope":["internal/orchestrate/run.go (new)","internal/orchestrate/preflight.go","internal/orchestrate/types.go","internal/orchestrate/types_test.go"],"acceptance":["RunRequest and RunResult types exist in internal/orchestrate","PreflightRequest and PreflightResult types exist in internal/orchestrate","go test ./internal/orchestrate passes","make check green"],"definition_of_done":"internal/orchestrate exposes caller-facing RunRequest, RunResult, PreflightRequest, and PreflightResult contracts. OrchestrateState remains an implementation detail for op-derived state rather than the command/runtime result surface.","priority":"high","confidence":"draft"}]
["create","ORCRUN-T02",1780450256,"codex-worker",{"title":"Implement repo-backed orchestration run preparation","parent":"ORCRUN-S1","type":"task","scope":["internal/orchestrate/run.go (new)","internal/orchestrate/preflight.go","internal/orchestrate/engine.go","internal/orchestrate/service.go","internal/orchestrate/verify.go"],"acceptance":["dry-run and mutating run share preparation-path tests","claim-if-needed behavior is covered by tests","scope conflict after claim verification is covered by tests","go test ./internal/orchestrate passes","make check green"],"definition_of_done":"Repo-backed orchestration run loads and materializes task truth, resolves model and auth, creates harness/git/op-log adapters, renders task context, claims if needed, verifies ownership, evaluates active scope conflicts after claim verification, and preserves dry-run path parity up to explicit side-effect gates.","priority":"high","confidence":"draft"}]
