["note","AOC-S1-T1",1787571347,"5207ee28-cdd8-48e6-98dc-7da179d4a40d~w-AOC-S1-T1",{"msg":"Writing ADR 0017 plus the normative section of docs/design/agent-output-contract.md from the issue DoD and sibling task contracts (envelope on stdout, named payload array, help[], definitive empty state, Protocol Output carve-out for harness-hook).","note_id":"note-1787571347437093752"}]
["decision","AOC-S1-T1",1787571347,"5207ee28-cdd8-48e6-98dc-7da179d4a40d~w-AOC-S1-T1",{"topic":"payload-key","choice":"command-named array, not the literal key payload","rationale":"Sibling DoDs use {count, issues[], help[]} and say each command names the payload key for its contents. A lint can require count == len(that array) without forcing a generic payload field."}]
["decision","AOC-S1-T1",1787571347,"5207ee28-cdd8-48e6-98dc-7da179d4a40d~w-AOC-S1-T1",{"topic":"extra-fields","choice":"adjunct members allowed when they are not a second results channel","rationale":"arm ready --waves and expired claims must fold into the same stdout object. Extra keys are allowed; stderr JSON for result data is not."}]
