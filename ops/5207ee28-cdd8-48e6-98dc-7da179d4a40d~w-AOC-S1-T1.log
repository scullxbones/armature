["decision","AOC-S1-T1",1787571347,"5207ee28-cdd8-48e6-98dc-7da179d4a40d~w-AOC-S1-T1",{"topic":"payload-key","choice":"command-named array, not the literal key payload","rationale":"Sibling DoDs use {count, issues[], help[]} and say each command names the payload key for its contents. A lint can require count == len(that array) without forcing a generic payload field."}]
