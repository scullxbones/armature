["note","LNGHZN-S10-T4",1786914392,"5207ee28-cdd8-48e6-98dc-7da179d4a40d~t4",{"msg":"Starting T4: default-strict validate, silent green, plan-release gate, warning burn-down via links + W5 story skip.","note_id":"note-1786914392704775754"}]
["decision","LNGHZN-S10-T4",1786914392,"5207ee28-cdd8-48e6-98dc-7da179d4a40d~t4",{"topic":"strict-default","choice":"CLI defaults Strict=true and fails closed; package Options.Strict stays explicit","rationale":"D7 is an arm validate UX contract. Library callers and existing warning unit tests keep opt-in Strict so they can still observe W* as warnings."}]
["decision","LNGHZN-S10-T4",1786914392,"5207ee28-cdd8-48e6-98dc-7da179d4a40d~t4",{"topic":"warning-burndown","choice":"serialize real W1 overlaps with arm link; W5 skips non-tasks","rationale":"D7: no waivers. Remaining W1 pairs name the same path and need ordering. Stories with multi-dir scope are intentional, so W5 is a task-only rule. NXTTN-S4-T3 gets context_files."}]
["decision","LNGHZN-S10-T4",1786914392,"5207ee28-cdd8-48e6-98dc-7da179d4a40d~t4",{"topic":"plan-release-gate","choice":"dag transition to verified runs full-graph strict validate","rationale":"Findings die at introduction. No subtree scoping at release. draft demotion is unchecked."}]
