{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Armature Review Bundle Schema",
  "description": "Schema for Armature semantic review bundles (arm review prepare output)",
  "type": "object",
  "required": ["schema_version", "bundle_id", "issue", "contract", "delivery", "fingerprints"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "description": "Review bundle schema version (currently 1)",
      "enum": [1]
    },
    "bundle_id": {
      "type": "string",
      "description": "Canonical bundle identifier (format: sha256:...)",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "issue": {
      "type": "object",
      "description": "Information about the issue being reviewed",
      "required": ["id", "type", "title", "outcome"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Issue identifier",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "description": "Issue type",
          "enum": ["epic", "story", "feature", "task", "bug"]
        },
        "title": {
          "type": "string",
          "description": "Issue title",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "description": "Recorded delivery outcome"
        }
      }
    },
    "contract": {
      "type": "object",
      "description": "Contractual requirements for the delivery",
      "required": ["definition_of_done", "acceptance"],
      "properties": {
        "definition_of_done": {
          "type": "string",
          "description": "Primary Definition of Done criterion (may be empty; the CLI does not require it to be non-empty)"
        },
        "scope": {
          "type": "array",
          "description": "List of files or areas in scope for the delivery",
          "items": {
            "type": "string"
          }
        },
        "acceptance": {
          "description": "Ordered list of acceptance criteria (may be null or empty when an issue legitimately has none)",
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "description": "Metadata about the completed delivery",
      "required": ["base_sha", "head_sha", "changed_files"],
      "properties": {
        "base_sha": {
          "type": "string",
          "description": "Parent commit SHA",
          "pattern": "^[a-f0-9]{40}$"
        },
        "head_sha": {
          "type": "string",
          "description": "Delivery commit SHA",
          "pattern": "^[a-f0-9]{40}$"
        },
        "changed_files": {
          "type": "array",
          "description": "Files modified in the delivery range",
          "items": {
            "type": "string"
          }
        },
        "diff": {
          "type": "string",
          "description": "Unified diff for the delivery range (may be omitted for large diffs)"
        }
      }
    },
    "fingerprints": {
      "type": "object",
      "description": "Canonical fingerprints for reproducibility",
      "required": ["contract", "delivery"],
      "properties": {
        "contract": {
          "type": "string",
          "description": "SHA-256 fingerprint of the contract",
          "pattern": "^[a-f0-9]{64}$"
        },
        "delivery": {
          "type": "string",
          "description": "SHA-256 fingerprint of the delivery metadata",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "activity": {
      "type": "object",
      "description": "Execution evidence from worktree activity log (optional)",
      "required": ["digest", "entry_count", "log_path"],
      "properties": {
        "digest": {
          "type": "string",
          "description": "SHA-256 fingerprint of the activity log file content",
          "pattern": "^[a-f0-9]{64}$"
        },
        "entry_count": {
          "type": "integer",
          "description": "Total number of entries in the activity log",
          "minimum": 0
        },
        "delivery_head_count": {
          "type": "integer",
          "description": "Number of entries at the delivery HEAD commit",
          "minimum": 0
        },
        "earlier_count": {
          "type": "integer",
          "description": "Number of entries at commits before the delivery HEAD",
          "minimum": 0
        },
        "log_path": {
          "type": "string",
          "description": "Absolute path to the activity log file"
        }
      }
    },
    "gate_evidence": {
      "type": "array",
      "description": "Wrapper-recorded gate runs from worker logs. Included in bundle_id.",
      "items": {
        "type": "object",
        "required": ["profile", "command", "head_sha", "start", "end", "exit"],
        "properties": {
          "profile": {
            "type": "string",
            "description": "Configured gate profile name"
          },
          "command": {
            "type": "array",
            "description": "Configured command argv",
            "items": {
              "type": "string"
            }
          },
          "head_sha": {
            "type": "string",
            "description": "HEAD of the invoking checkout at run start"
          },
          "start": {
            "type": "integer",
            "description": "Unix epoch seconds when the command started"
          },
          "end": {
            "type": "integer",
            "description": "Unix epoch seconds when the command finished"
          },
          "exit": {
            "type": "integer",
            "description": "Process exit code"
          },
          "uncommitted": {
            "type": "boolean",
            "description": "True when the invoking checkout was dirty before or after the command (not citable)"
          },
          "output_hash": {
            "type": "string",
            "description": "SHA-256 hex digest of the gate log file"
          },
          "output_head": {
            "type": "string",
            "description": "First 1KB of gate output (or the full output if shorter)"
          },
          "output_tail": {
            "type": "string",
            "description": "Last 1KB of gate output when the log was truncated"
          },
          "log_path": {
            "type": "string",
            "description": "Absolute path to the gate log file re-hashed at record time"
          }
        }
      }
    }
  }
}
